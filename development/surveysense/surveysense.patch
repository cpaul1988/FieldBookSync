+++ b/tests/test_surveysense_delivery.py
@@ -0,0 +1,131 @@
+import copy
+import csv
+import io
+import json
+from pathlib import Path
+
+import pytest
+
+from fieldbook_sync.models import AppState, DipStatus, EvidenceBasis, FieldBookPage, PageEvidence, PipeMeasurement, ResultRecord, ReviewState
+from fieldbook_sync.project_files import create_project_bundle, load_project_bundle
+from fieldbook_sync.survey_delivery import pipe_calculation_rows, pipe_calculations_csv, build_fieldbook_review_pdf
+
+
+def structure(**kwargs):
+    values = dict(point_id="MH-101", elevation=101.5, code="MH", dip_status=DipStatus.YES,
+                  review_state=ReviewState.ACCEPTED, pipes=[PipeMeasurement(dip=6.4)])
+    values.update(kwargs)
+    return ResultRecord(**values)
+
+
+def calculate(result, **kwargs):
+    opts = dict(elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+    opts.update(kwargs)
+    return pipe_calculation_rows([result], **opts)[0]
+
+
+def test_per_pipe_calculation_keeps_raw_observations():
+    r = structure(pipes=[PipeMeasurement(dip=6.4, dip_raw="6.40"), PipeMeasurement(dip=7.8)])
+    before = copy.deepcopy(r.model_dump())
+    rows = pipe_calculation_rows([r], elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+    assert [row["CalculatedInvert"] for row in rows] == pytest.approx([95.1, 93.7])
+    assert rows[0]["DipRaw"] == "6.40"
+    assert r.model_dump() == before
+
+
+@pytest.mark.parametrize("elevation_unit,dip_unit,rim,dip,expected", [
+    ("m", "ft", 100, 10, 96.952),
+    ("m", "usft", 100, 3937, -1100),
+    ("ft", "m", 100, 3.048, 90),
+    ("usft", "m", 4000, 1200, 63),
+])
+def test_exact_unit_conventions(elevation_unit, dip_unit, rim, dip, expected):
+    r = structure(elevation=rim, pipes=[PipeMeasurement(dip=dip)])
+    row = calculate(r, elevation_unit=elevation_unit, dip_unit=dip_unit)
+    assert row["CalculatedInvert"] == pytest.approx(expected, abs=1e-10)
+
+
+@pytest.mark.parametrize("dip", [None, -0.01, float("nan"), float("inf")])
+def test_missing_or_invalid_depth_never_becomes_an_invert(dip):
+    row = calculate(structure(pipes=[PipeMeasurement(dip=dip)]))
+    assert row["CalculatedInvert"] == ""
+    assert row["QCNotes"]
+
+
+@pytest.mark.parametrize("rim", [None, float("nan"), float("inf")])
+def test_missing_or_invalid_rim_blocks_calculation(rim):
+    assert calculate(structure(elevation=rim))["CalculatedInvert"] == ""
+
+
+def test_rim_reference_must_be_explicit():
+    row = calculate(structure(), confirmed_rim=False)
+    assert row["MeasuredDip"] == 6.4
+    assert row["CalculatedInvert"] == ""
+    with pytest.raises(ValueError, match="explicit"):
+        calculate(structure(), dip_unit="feet")
+
+
+def test_unreviewed_and_empty_pipe_records_are_visible():
+    row = calculate(structure(pipes=[], review_state=ReviewState.UNREVIEWED))
+    assert row["PipeIndex"] == ""
+    assert "Missing" in row["QCNotes"] and "not been accepted" in row["QCNotes"]
+
+
+def test_csv_prevents_formula_text_but_keeps_negative_numbers():
+    row = calculate(structure(point_id="=1+1", elevation=-10))
+    payload = pipe_calculations_csv([row]).decode("utf-8-sig")
+    data = next(csv.DictReader(io.StringIO(payload)))
+    assert data["PointID"] == "'=1+1"
+    assert float(data["RimElevation"]) == -10
+    assert float(data["CalculatedInvert"]) == pytest.approx(-16.4)
+
+
+def test_new_inventory_and_export_audit_survive_project_roundtrip(tmp_path):
+    state = AppState(raw_numeric_point_ids=[100, 101, 200], raw_point_ids_ignored=2,
+                     raw_point_inventory_complete=True, delivery_audit=[{"export_id":"fixture", "sha256":"abc"}])
+    pages = tmp_path / "pages"
+    pages.mkdir()
+    bundle = create_project_bundle(state, pages, tmp_path / "out")
+    restored, _ = load_project_bundle(bundle, tmp_path / "restored", tmp_path / "examples")
+    assert restored.raw_numeric_point_ids == [100, 101, 200]
+    assert restored.raw_point_inventory_complete
+    assert restored.delivery_audit == state.delivery_audit
+    assert AppState.model_validate({"project_name":"Legacy"}).raw_point_inventory_complete is False
+
+
+def test_pdf_has_source_page_and_separate_notes(tmp_path):
+    import fitz
+    from PIL import Image, ImageDraw
+    pages = tmp_path / "pages"
+    pages.mkdir()
+    image = Image.new("RGB", (1200, 1500), "white")
+    draw = ImageDraw.Draw(image)
+    draw.text((80, 80), "SYNTHETIC TEST PAGE: MH-101, dip 6.40", fill="black")
+    image_path = pages / "page.png"
+    image.save(image_path)
+    evidence = PageEvidence(matched_point_id="MH-101", source_name="fixture.pdf", page_number=1,
+                            page_id="p1", basis=EvidenceBasis.MEASUREMENT, dipped=DipStatus.YES)
+    st = AppState(project_name="QA fixture - source images and pipe notes", results=[structure(evidence_records=[evidence])],
+                  fieldbook_pages=[FieldBookPage(page_id="p1", source_name="fixture.pdf", page_number=1,
+                                                 image_path=str(image_path), mime_type="image/png")])
+    options = dict(elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+    rows = pipe_calculation_rows(st.results, **options)
+    out = build_fieldbook_review_pdf(st, rows, tmp_path / "review.pdf", page_root=pages, calculation_options=options)
+    with fitz.open(out) as pdf:
+        assert len(pdf) == 3
+        text = "\n".join(page.get_text() for page in pdf)
+        assert "95.1000" in text and "MH-101" in text and "Draft for review" in text
+        assert len(pdf[1].get_images()) == 1
+        assert "Dip notes for fixture.pdf" in pdf[2].get_text()
+    st.fieldbook_pages[0].image_path = str(tmp_path / "outside.png")
+    with pytest.raises(ValueError, match="unavailable"):
+        build_fieldbook_review_pdf(st, rows, tmp_path / "bad.pdf", page_root=pages, calculation_options=options)
+
+
+def test_missing_source_reference_is_not_silently_dropped(tmp_path):
+    st = AppState(results=[structure(evidence_records=[PageEvidence(matched_point_id="MH-101",
+                        source_name="missing.pdf", page_id="missing", page_number=8)])])
+    options = dict(elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+    with pytest.raises(ValueError, match="pages are missing"):
+        build_fieldbook_review_pdf(st, pipe_calculation_rows(st.results, **options), tmp_path / "bad.pdf",
+                                   page_root=tmp_path, calculation_options=options)
