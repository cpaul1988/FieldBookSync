diff --git a/fieldbook_sync/sewer_pickup.py b/fieldbook_sync/sewer_pickup.py
new file mode 100644
index 0000000..923116c
--- /dev/null
+++ b/fieldbook_sync/sewer_pickup.py
@@ -0,0 +1,220 @@
+"""Conservative sewer completion maps from surveyed points and selected GIS.
+
+GIS is supplemental evidence. Only unique matches inside the operator's stated
+tolerance can clear a GIS pickup; ambiguous or displaced identities stay visible.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import json
+import math
+import zipfile
+from collections import Counter, defaultdict
+from itertools import product
+from xml.etree import ElementTree as ET
+
+from pyproj import Geod
+
+from .survey_delivery import _csv_value, pipe_calculation_rows
+from .spatial_fields import scalar_identity
+
+GEOD = Geod(ellps="WGS84")
+STATUS_LABELS = {
+    "MISSING_SURVEY": "Missing survey",
+    "MISSING_DIP": "Surveyed - dip needed",
+    "REVIEW": "Review needed",
+    "COMPLETE": "Survey and dips reviewed",
+}
+COLORS = {"MISSING_SURVEY": "#d93b44", "MISSING_DIP": "#e9a23b",
+          "REVIEW": "#935bd5", "COMPLETE": "#249775"}
+
+
+def _location(value):
+    if not isinstance(value, (list, tuple)) or len(value) < 2:
+        return None
+    try:
+        lon, lat = map(float, value[:2])
+    except (TypeError, ValueError):
+        return None
+    return (lon, lat) if math.isfinite(lon) and math.isfinite(lat) and -180 <= lon <= 180 and -90 <= lat <= 90 else None
+
+
+def _cell(lon, lat, size):
+    # Ellipsoidal ECEF chord buckets bound geodesic candidates without the
+    # longitude discontinuity at the antimeridian or degree/metre assumptions.
+    lon, lat = math.radians(lon), math.radians(lat)
+    e2 = 6.6943799901413165e-3
+    n = 6378137.0 / math.sqrt(1 - e2 * math.sin(lat) ** 2)
+    return tuple(math.floor(v / size) for v in (
+        n * math.cos(lat) * math.cos(lon), n * math.cos(lat) * math.sin(lon),
+        n * (1 - e2) * math.sin(lat)))
+
+
+def _completion(result, options):
+    if result is None or not result.pipes or all(p.dip is None for p in result.pipes):
+        return "MISSING_DIP", "No measured pipe dip recorded"
+    rows = pipe_calculation_rows([result], **options)
+    notes = list(dict.fromkeys(row["QCNotes"] for row in rows if row["QCNotes"]))
+    complete = (result.dip_status.value == "YES" and not notes
+                and all(row["CalculatedInvert"] != "" for row in rows))
+    return ("COMPLETE", "All recorded pipe dips and rim reference reviewed") if complete else (
+        "REVIEW", "; ".join(notes) or "Dip completion has not been confirmed")
+
+
+def pickup_rows(state, coordinates, *, layer_ids, id_field, tolerance_m, calculation_options):
+    if not math.isfinite(tolerance_m) or not 0 < tolerance_m <= 1000:
+        raise ValueError("Choose a finite GIS matching tolerance greater than zero and no more than 1000 metres.")
+    if not state.survey_points:
+        raise ValueError("Import the surveyed structure points first.")
+    point_ids = [p.point_id for p in state.survey_points]
+    if len(set(point_ids)) != len(point_ids):
+        raise ValueError("Duplicate survey PointIDs must be resolved before exporting pickup maps.")
+    result_ids = [r.point_id for r in state.results]
+    if len(set(result_ids)) != len(result_ids):
+        raise ValueError("Duplicate result PointIDs must be resolved before exporting pickup maps.")
+    results = {r.point_id: r for r in state.results}
+    rows, survey_rows, buckets = [], {}, defaultdict(list)
+    warnings = []
+    for point in state.survey_points:
+        location = _location(coordinates.get(point.point_id))
+        status, reason = _completion(results.get(point.point_id), calculation_options)
+        row = {"RecordType": "Survey", "PointID": point.point_id, "GISLayer": "", "GISFeatureID": "",
+               "GISAssetID": "", "Status": status, "Reason": reason, "Longitude": location[0] if location else "",
+               "Latitude": location[1] if location else "", "MatchDistanceM": "", "MatchMethod": "",
+               "Source": point.source_file}
+        if location is None:
+            row.update(Status="REVIEW", Reason="Survey coordinates could not be placed in WGS84; listed in checklist only")
+        else:
+            buckets[_cell(*location, tolerance_m)].append(point.point_id)
+        survey_rows[point.point_id] = row
+        rows.append(row)
+    if any(r["Longitude"] == "" for r in rows):
+        warnings.append("Unlocated survey points are retained in checklist.csv but cannot appear as map pins.")
+    selected = set(layer_ids)
+    layers = [layer for layer in state.map_layers if layer.layer_id in selected]
+    if {layer.layer_id for layer in layers} != selected:
+        raise ValueError("A selected supplemental GIS layer is no longer available.")
+    features = []
+    for layer in layers:
+        if id_field and not any(id_field in feature.properties for feature in layer.features):
+            raise ValueError(f"GIS ID field '{id_field}' is absent in layer '{layer.name}'.")
+        ignored = 0
+        for feature in layer.features:
+            if feature.geometry.get("type") != "Point":
+                ignored += 1
+                continue
+            location = _location(feature.geometry.get("coordinates"))
+            raw_id = feature.properties.get(id_field) if id_field else None
+            asset_id = scalar_identity(raw_id)
+            features.append((layer, feature, location, asset_id))
+        if ignored:
+            warnings.append(f"{layer.name}: {ignored} non-Point features excluded; select a structure point layer.")
+        if layer.warning:
+            warnings.append(f"{layer.name}: {layer.warning}")
+    if layers and not features:
+        raise ValueError("The selected GIS layers contain no individual structure Point features.")
+    candidates, reverse = {}, defaultdict(list)
+    for index, (_, _, location, _) in enumerate(features):
+        found = []
+        if location:
+            center = _cell(*location, tolerance_m)
+            for delta in product((-1, 0, 1), repeat=3):
+                for point_id in buckets.get(tuple(a + b for a, b in zip(center, delta)), []):
+                    row = survey_rows[point_id]
+                    distance = abs(GEOD.inv(*location, row["Longitude"], row["Latitude"])[2])
+                    if distance <= tolerance_m:
+                        found.append((point_id, distance))
+                        reverse[point_id].append(index)
+        candidates[index] = found
+    asset_counts = Counter(asset for _, _, _, asset in features if asset)
+    for index, (layer, feature, location, asset) in enumerate(features):
+        found = candidates[index]
+        exact = survey_rows.get(asset) if asset else None
+        reason = "No surveyed structure inside the selected matching tolerance"
+        status, method, match = "MISSING_SURVEY", "", None
+        if location is None:
+            status, reason = "REVIEW", "Invalid GIS coordinates; listed in checklist only"
+        elif asset and asset_counts[asset] > 1:
+            status, reason = "REVIEW", "Duplicate GIS asset identity requires review"
+        elif exact is not None and not any(pid == asset for pid, _ in found):
+            status, reason = "REVIEW", "Matching PointID exists outside tolerance or has no geographic location"
+        elif len(found) == 1 and len(reverse[found[0][0]]) == 1:
+            match = found[0]
+            method = "ID and proximity" if match[0] == asset else "Unique proximity"
+        elif found:
+            status, reason = "REVIEW", "Multiple candidate structures or GIS features require a reviewed match"
+        if match:
+            row = survey_rows[match[0]]
+            row.update(GISLayer=layer.name, GISFeatureID=feature.feature_id, GISAssetID=asset,
+                       MatchDistanceM=round(match[1], 4), MatchMethod=method)
+            continue
+        affected = {pid for pid, _ in found}
+        if exact is not None:
+            affected.add(asset)
+        for point_id in affected:
+            row = survey_rows[point_id]
+            row.update(Status="REVIEW", Reason=row["Reason"] + "; " + reason)
+        rows.append({"RecordType": "GIS", "PointID": "", "GISLayer": layer.name,
+                     "GISFeatureID": feature.feature_id, "GISAssetID": asset, "Status": status, "Reason": reason,
+                     "Longitude": location[0] if location else "", "Latitude": location[1] if location else "",
+                     "MatchDistanceM": "", "MatchMethod": "", "Source": layer.source_name})
+    return rows, warnings
+
+
+def build_pickup_kmz(rows, *, project_name, manifest):
+    from PIL import Image, ImageDraw
+    ns = "http://www.opengis.net/kml/2.2"
+    ET.register_namespace("", ns)
+    def element(parent, tag, text=None, **attrs):
+        item = ET.SubElement(parent, f"{{{ns}}}{tag}", attrs)
+        if text is not None:
+            item.text = str(text)
+        return item
+    root = ET.Element(f"{{{ns}}}kml")
+    document = element(root, "Document")
+    element(document, "name", f"SurveySense - {project_name} - sewer pickup")
+    element(document, "description", "Completion covers the recorded pipes. GIS is supplemental; review ambiguous matches. See checklist.csv for all records, including unlocated points.")
+    folders = {}
+    for status, label in STATUS_LABELS.items():
+        style = element(document, "Style", id=status)
+        icon_style = element(style, "IconStyle")
+        element(icon_style, "scale", "1.1")
+        element(element(icon_style, "Icon"), "href", f"icons/{status}.png")
+        folder = element(document, "Folder")
+        element(folder, "name", f"{label} ({sum(r['Status'] == status for r in rows)})")
+        folders[status] = folder
+    for row in rows:
+        if row["Longitude"] == "" or row["Latitude"] == "":
+            continue
+        placemark = element(folders[row["Status"]], "Placemark")
+        element(placemark, "name", row["PointID"] or row["GISAssetID"] or row["GISFeatureID"])
+        element(placemark, "styleUrl", f"#{row['Status']}")
+        element(placemark, "description", row["Reason"])
+        data = element(placemark, "ExtendedData")
+        for key, value in row.items():
+            element(element(data, "Data", name=key), "value", value)
+        point = element(placemark, "Point")
+        element(point, "altitudeMode", "clampToGround")
+        element(point, "coordinates", f"{row['Longitude']:.10f},{row['Latitude']:.10f},0")
+    table = io.StringIO(newline="")
+    writer = csv.DictWriter(table, fieldnames=list(rows[0]), lineterminator="\r\n")
+    writer.writeheader()
+    writer.writerows({key: _csv_value(value) for key, value in row.items()} for row in rows)
+    result = io.BytesIO()
+    with zipfile.ZipFile(result, "w", zipfile.ZIP_DEFLATED) as archive:
+        archive.writestr("doc.kml", ET.tostring(root, encoding="utf-8", xml_declaration=True))
+        archive.writestr("checklist.csv", table.getvalue().encode("utf-8-sig"))
+        archive.writestr("manifest.json", json.dumps(manifest, indent=2, ensure_ascii=False, allow_nan=False))
+        for status, color in COLORS.items():
+            icon = Image.new("RGBA", (32, 32), (0, 0, 0, 0))
+            ImageDraw.Draw(icon).ellipse((3, 3, 29, 29), fill=color, outline="white", width=3)
+            image_bytes = io.BytesIO()
+            icon.save(image_bytes, format="PNG")
+            archive.writestr(f"icons/{status}.png", image_bytes.getvalue())
+    data = result.getvalue()
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        if archive.testzip() is not None:
+            raise ValueError("KMZ verification failed.")
+        ET.fromstring(archive.read("doc.kml"))
+    return data
