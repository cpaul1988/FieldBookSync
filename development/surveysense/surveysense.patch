+import hashlib
+import importlib
+import io
+import json
+import sys
+import threading
+import types
+import zipfile
+
+import pytest
+from fastapi.testclient import TestClient
+
+from fieldbook_sync.models import AppState, CodeProfile, CodeRule, ResultRecord, PipeMeasurement, SurveyPoint
+from fieldbook_sync.profiles import save_profile
+from fieldbook_sync.storage import AppStorage
+
+
+@pytest.fixture
+def service(tmp_path, monkeypatch):
+    module = importlib.import_module("fieldbook_sync.app")
+    monkeypatch.setenv("LOCALAPPDATA", str(tmp_path))
+    storage = AppStorage()
+    storage.state.selected_profile = "QA"
+    save_profile(storage.profile_dir, CodeProfile(name="QA", codes=[CodeRule(code="MH")]))
+    monkeypatch.setattr(module.runtime, "storage", storage)
+    with TestClient(module.app) as client:
+        yield module, storage, client
+
+
+def fill_results(storage):
+    storage.state.results = [ResultRecord(point_id="100", code="MH", elevation=100,
+        review_state="ACCEPTED", dip_status="YES", pipes=[PipeMeasurement(dip=6.4)])]
+
+
+OPTIONS = dict(elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+
+
+def test_real_import_preserves_non_target_numeric_ids(service):
+    _, storage, client = service
+    response = client.post("/api/import-survey", files=[("files", ("points.csv", b"PointID,Northing,Easting,Elevation,Code\n100,1000,2000,100,MH\n101,1001,2001,100,TREE\n103,1003,2003,100,MH\n", "text/csv"))])
+    assert response.status_code == 200, response.text
+    assert [p.point_id for p in storage.state.survey_points] == ["100", "103"]
+    assert storage.state.raw_numeric_point_ids == [100, 101, 103]
+    response = client.get("/api/survey/available-ranges")
+    assert response.status_code == 200
+    assert "102,102,102-102,1" in response.text
+    assert "101-" not in response.text
+
+
+def test_old_project_cannot_advertise_filtered_ids_as_available(service):
+    _, storage, client = service
+    storage.state.survey_points = [SurveyPoint(point_id="100", code="MH")]
+    assert client.get("/api/survey/available-ranges").status_code == 409
+
+
+def test_verified_export_records_checksum_and_survives_state_reload(service):
+    _, storage, client = service
+    fill_results(storage)
+    response = client.post("/api/delivery/pipe-calculations.csv", json=OPTIONS)
+    assert response.status_code == 200
+    assert len(storage.state.delivery_audit) == 1
+    event = storage.state.delivery_audit[0]
+    assert event["sha256"] == hashlib.sha256(response.content).hexdigest()
+    assert event["export_id"] == response.headers["x-surveysense-export-id"]
+    assert AppState.model_validate_json(storage.state_path.read_text()).delivery_audit == [event]
+    assert storage.state.history == []
+
+
+def test_failed_autosave_never_reports_completed_export(service, monkeypatch):
+    _, storage, client = service
+    fill_results(storage)
+    def fail():
+        raise OSError("Synthetic full disk")
+    monkeypatch.setattr(storage, "save", fail)
+    response = client.post("/api/delivery/pipe-calculations.csv", json=OPTIONS)
+    assert response.status_code >= 400
+    assert storage.state.delivery_audit == []
+    assert list(storage.export_dir.iterdir()) == []
+
+
+def test_export_units_are_required_and_validated(service):
+    _, storage, client = service
+    fill_results(storage)
+    for payload in ({}, {**OPTIONS, "dip_unit":"feet"}):
+        assert client.post("/api/delivery/pipe-calculations.csv", json=payload).status_code == 422
+    assert storage.state.delivery_audit == []
+
+
+def test_pickup_route_requires_crs_then_exports_valid_kmz(service):
+    _, storage, client = service
+    fill_results(storage)
+    storage.state.survey_points = [SurveyPoint(point_id="100", code="MH", easting=-90.2, northing=38.6)]
+    payload = {**OPTIONS, "tolerance_m":2}
+    assert client.post("/api/sewer/pickup.kmz", json=payload).status_code == 400
+    storage.state.map_project_crs = "EPSG:4326"
+    response = client.post("/api/sewer/pickup.kmz", json=payload)
+    assert response.status_code == 200, response.text
+    with zipfile.ZipFile(io.BytesIO(response.content)) as archive:
+        manifest = json.loads(archive.read("manifest.json"))
+        assert manifest["counts"]["COMPLETE"] == 1
+    assert storage.state.delivery_audit[-1]["sha256"] == hashlib.sha256(response.content).hexdigest()
+
+
+def test_backend_shutdown_signal_closes_native_window(monkeypatch):
+    # Exercise desktop.main with a fake GUI, not os._exit or a real local server.
+    fake = types.ModuleType("webview")
+    monkeypatch.setitem(sys.modules, "webview", fake)
+    sys.modules.pop("desktop", None)
+    desktop = importlib.import_module("desktop")
+    monkeypatch.setattr(sys, "argv", ["desktop.py"])
+    calls = []
+    shutdown = threading.Event()
+    monkeypatch.setattr(desktop.runtime, "shutdown_event", shutdown)
+    monkeypatch.setattr(desktop, "_choose_port", lambda *args: 8765)
+    monkeypatch.setattr(desktop, "_wait_for_server", lambda *args: True)
+    monkeypatch.setattr(desktop, "request_application_shutdown", lambda *args: shutdown.set())
+    monkeypatch.setattr(desktop, "finalize_application_shutdown", lambda: calls.append("finalized"))
+    monkeypatch.setattr(desktop.os, "_exit", lambda code: pytest.fail("Test must not terminate the process"))
+    server = types.SimpleNamespace(run=lambda: None, should_exit=False)
+    monkeypatch.setattr(desktop.uvicorn, "Config", lambda *args, **kwargs: None)
+    monkeypatch.setattr(desktop.uvicorn, "Server", lambda config: server)
+    class Event:
+        def __init__(self): self.handlers = []
+        def __iadd__(self, handler):
+            self.handlers.append(handler)
+            return self
+    event = Event()
+    def destroy():
+        calls.append("destroyed")
+        for handler in event.handlers:
+            handler()
+    window = types.SimpleNamespace(events=types.SimpleNamespace(closed=event), destroy=destroy)
+    fake.create_window = lambda *args, **kwargs: window
+    def start(callback=None, **kwargs):
+        assert callable(callback), "The GUI must watch backend shutdown requests"
+        shutdown.set()  # Same event signalled by the update endpoint.
+        callback()
+    fake.start = start
+    monkeypatch.setattr(desktop.threading, "enumerate", lambda: [threading.current_thread()])
+    desktop.main()
+    assert calls == ["destroyed", "finalized"]
+    assert server.should_exit
+
+
+def test_ground_preview_and_export_recalculate_and_audit(service):
+    from pyproj import Transformer
+    _, storage, client = service
+    samples = []
+    for point_id, latitude in (("A", 38), ("B", 39)):
+        x,y = Transformer.from_crs("EPSG:4269", "EPSG:26915", always_xy=True).transform(-93, latitude)
+        samples.append({"point_id":point_id, "source_crs":"EPSG:26915", "easting":x, "northing":y, "ellipsoid_height_m":0})
+    payload = {"samples":samples, "target_crs":"EPSG:26915", "origin_point_id":"A", "tolerance_ppm":20,
+               "confirmed_ellipsoid_heights":True}
+    response = client.post("/api/ground/preview", json=payload)
+    assert response.status_code == 200, response.text
+    assert response.json()["grid_to_ground"] == pytest.approx(1/0.9996, abs=1e-10)
+    assert storage.state.delivery_audit == []
+    response = client.post("/api/ground/design.zip", json={**payload, "grid_to_ground":1})
+    assert response.status_code == 200, response.text
+    with zipfile.ZipFile(io.BytesIO(response.content)) as archive:
+        report = json.loads(archive.read("ground-design.json"))
+        assert report["result"]["max_abs_residual_ppm"] == pytest.approx(400, abs=0.001)
+        assert not report["result"]["all_samples_within_tolerance"]
+    assert len(storage.state.delivery_audit) == 1
+    assert storage.state.survey_points == []
+    assert client.post("/api/ground/preview", json={**payload, "confirmed_ellipsoid_heights":False}).status_code == 400
