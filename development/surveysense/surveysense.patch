+// DOM integration checks against an isolated, running FastAPI fixture.
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const {JSDOM}=require(process.env.SURVEYSENSE_JSDOM_PATH || 'jsdom');
+const base=process.env.SURVEYSENSE_TEST_URL || 'http://127.0.0.1:8793';
+
+function page(){
+  const dom=new JSDOM('<!doctype html><main id="content"></main>',{runScripts:'outside-only',url:base});
+  const w=dom.window, downloads=[];
+  w.fetch=(url,opts)=>fetch(new URL(url,base),opts);
+  w.esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  w.openModal=(_,html)=>{w.document.querySelector('#content').innerHTML=html;};
+  w.closeModal=()=>{}; w.toast=()=>{};
+  w.URL.createObjectURL=()=> 'blob:fixture'; w.URL.revokeObjectURL=()=>{};
+  w.HTMLAnchorElement.prototype.click=function(){downloads.push(this.download);};
+  for(const name of ['delivery.js','ground_design.js']) w.eval(fs.readFileSync(path.join(__dirname,'../fieldbook_sync/static',name),'utf8'));
+  return {dom,w,downloads,$:s=>w.document.querySelector(s)};
+}
+async function until(predicate){
+  const deadline=Date.now()+5000;
+  while(!predicate()) {if(Date.now()>deadline) throw new Error('UI operation did not finish within five seconds'); await new Promise(r=>setTimeout(r,10));}
+}
+
+test('pipe export submits selected units and produces a downloadable CSV',async()=>{
+  const p=page();
+  try{
+    p.w.openPipeDelivery('pipe-calculations.csv');
+    p.$('#deliveryElevationUnit').value='ft'; p.$('#deliveryDipUnit').value='ft'; p.$('#deliveryConfirmedRim').checked=true;
+    p.$('#pipeDeliveryForm').dispatchEvent(new p.w.Event('submit',{cancelable:true,bubbles:true}));
+    await until(()=>!p.$('#deliveryGenerate').disabled);
+    assert.equal(p.downloads.length,1,p.$('#deliveryProgress').textContent);
+    assert.match(p.downloads[0],/pipe-calculations\.csv$/);
+    assert.match(p.$('#deliveryProgress').textContent,/checksum/);
+  }finally{p.dom.window.close();}
+});
+
+test('pickup form loads GIS fields and produces a KMZ',async()=>{
+  const p=page();
+  try{
+    await p.w.openSewerPickup();
+    p.$('#pickupLayer').value='fixture-gis'; p.$('#pickupLayer').dispatchEvent(new p.w.Event('change'));
+    assert.equal(p.$('#pickupIdField').options[1].value,'AssetID');
+    p.$('#pickupIdField').value='AssetID'; p.$('#pickupTolerance').value='2';
+    p.$('#pickupElevation').value='ft'; p.$('#pickupDip').value='ft'; p.$('#pickupRim').checked=true;
+    p.$('#pickupForm').dispatchEvent(new p.w.Event('submit',{cancelable:true,bubbles:true}));
+    await until(()=>!p.$('#pickupExport').disabled);
+    assert.equal(p.downloads.length,1,p.$('#pickupProgress').textContent);
+    assert.match(p.downloads[0],/sewer-pickup\.kmz$/);
+  }finally{p.dom.window.close();}
+});
+
+test('ground preview draws samples, changes residuals, exports and invalidates stale inputs',async()=>{
+  const p=page();
+  try{
+    p.w.openGroundDesign();
+    p.$('#groundTarget').value='EPSG:26915'; p.$('#groundOrigin').value='A'; p.$('#groundTolerance').value='20';
+    p.$('#groundHeightConfirmed').checked=true;
+    p.$('#groundSamples').value='PointID,SourceCRS,Easting,Northing,EllipsoidHeightM\nA,EPSG:4269,-93,38,0\nB,EPSG:4269,-93,39,0';
+    p.$('#groundForm').dispatchEvent(new p.w.Event('submit',{cancelable:true,bubbles:true}));
+    await until(()=>!p.$('#groundCalculate').disabled);
+    assert.equal(p.$('#groundPlot').querySelectorAll('circle').length,2,p.$('#groundProgress').textContent);
+    assert.match(p.$('#groundMetrics').textContent,/All samples meet/);
+    p.$('#groundMultiplier').value='1'; p.$('#groundMultiplier').dispatchEvent(new p.w.Event('input'));
+    assert.match(p.$('#groundMetrics').textContent,/400\.000 ppm/);
+    assert.match(p.$('#groundMetrics').textContent,/Samples exceed/);
+    p.$('#groundExport').click(); await until(()=>!p.$('#groundExport').disabled);
+    assert.match(p.downloads[0],/ground-design\.zip$/);
+    p.$('#groundOrigin').value='missing'; p.$('#groundOrigin').dispatchEvent(new p.w.Event('input',{bubbles:true}));
+    assert.equal(p.$('#groundOutput').style.display,'none');
+    assert.equal(p.$('#groundExport').disabled,true);
+  }finally{p.dom.window.close();}
+});
+
+test('malformed sample values fail visibly before export',async()=>{
+  const p=page();
+  try{
+    p.w.openGroundDesign();
+    p.$('#groundSamples').value='PointID,SourceCRS,Easting,Northing,EllipsoidHeightM\nA,EPSG:4269,-93,38,\nB,EPSG:4269,-93,39,0';
+    p.$('#groundForm').dispatchEvent(new p.w.Event('submit',{cancelable:true,bubbles:true}));
+    await until(()=>!p.$('#groundCalculate').disabled);
+    assert.match(p.$('#groundProgress').textContent,/ellipsoid height: enter a finite number/);
+    assert.equal(p.downloads.length,0);
+  }finally{p.dom.window.close();}
+});
