+"""Create synthetic UI fixtures only inside an explicitly supplied test directory."""
+import os
+from pathlib import Path
+
+if not os.environ.get("LOCALAPPDATA"):
+    raise SystemExit("Set LOCALAPPDATA to a disposable test directory before preparing a fixture.")
+from fieldbook_sync.storage import AppStorage
+from fieldbook_sync.models import AppState, SurveyPoint, ResultRecord, PipeMeasurement, MapLayer, MapFeature
+from pyproj import Transformer
+
+storage=AppStorage()
+if storage.state_path.exists():
+    raise SystemExit("Refusing to overwrite an existing project. Use a new disposable fixture directory.")
+storage.state=AppState(project_name="SurveySense QA fixture",map_project_crs="EPSG:26996",
+    raw_numeric_point_ids=[100,101,103],raw_point_inventory_complete=True)
+x,y=Transformer.from_crs("EPSG:4269","EPSG:26996",always_xy=True).transform(-90.2,38.6)
+storage.state.survey_points=[SurveyPoint(point_id="100",code="MH",easting=x,northing=y,elevation=100)]
+storage.state.results=[ResultRecord(point_id="100",code="MH",easting=x,northing=y,elevation=100,
+    dip_status="YES",review_state="ACCEPTED",pipes=[PipeMeasurement(dip=6.4)])]
+storage.state.map_layers=[MapLayer(name="QA sewer GIS",layer_id="fixture-gis",features=[
+    MapFeature(feature_id="GIS-1",geometry={"type":"Point","coordinates":[-90.2,38.6]},properties={"AssetID":"100"})])]
+storage.save()
diff --git a/tests/run_ui_tests.py b/tests/run_ui_tests.py
new file mode 100644
index 0000000..3c2748f
--- /dev/null
+++ b/tests/run_ui_tests.py
@@ -0,0 +1,45 @@
+"""Run DOM integration tests with their server in one isolated process namespace."""
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.request
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix="surveysense-ui-") as temp:
+    env = dict(os.environ)
+    env["LOCALAPPDATA"] = str(Path(temp) / "data")
+    env["PYTHONPATH"] = str(root) + os.pathsep + env.get("PYTHONPATH", "")
+    env["SURVEYSENSE_TEST_URL"] = "http://127.0.0.1:8793"
+    subprocess.run([sys.executable, str(root / "tests/prepare_ui_fixture.py")], env=env, check=True)
+    with (Path(temp) / "server.log").open("w+") as log:
+        server = subprocess.Popen([sys.executable, "-m", "uvicorn", "fieldbook_sync.app:app",
+                                   "--host", "127.0.0.1", "--port", "8793", "--log-level", "warning"],
+                                  env=env, cwd=root, stdout=log, stderr=log)
+        try:
+            deadline = time.monotonic() + 12
+            while time.monotonic() < deadline:
+                if server.poll() is not None:
+                    break
+                try:
+                    with urllib.request.urlopen(env["SURVEYSENSE_TEST_URL"] + "/api/sewer/pickup-options", timeout=0.5):
+                        break
+                except Exception:
+                    time.sleep(0.05)
+            else:
+                raise RuntimeError("The isolated test server did not become ready")
+            if server.poll() is not None:
+                log.seek(0)
+                raise RuntimeError(log.read())
+            completed = subprocess.run(["node", "--test", str(root / "tests/ui-delivery.test.cjs")],
+                                       cwd=root, env=env, timeout=60)
+        finally:
+            server.terminate()
+            try:
+                server.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                server.kill()
+                server.wait(timeout=5)
+        raise SystemExit(completed.returncode)
diff --git a/tests/test_ground_design.py b/tests/test_ground_design.py
new file mode 100644
index 0000000..c4debda
--- /dev/null
+++ b/tests/test_ground_design.py
@@ -0,0 +1,66 @@
+import pytest
+from pyproj import Transformer
+
+from fieldbook_sync.ground_design import ground_preview, fit_minimax_multiplier
+
+
+def sample(point_id, lon, lat, source="EPSG:26915", height=0):
+    x, y = Transformer.from_crs("EPSG:4269", source, always_xy=True).transform(lon, lat)
+    return dict(point_id=point_id, easting=x, northing=y, source_crs=source, ellipsoid_height_m=height)
+
+
+def test_minimax_residuals_are_balanced_for_common_grid_factors():
+    factors = [1.0000878, 1.0000712]
+    multiplier = fit_minimax_multiplier(factors)
+    errors = [(multiplier * c - 1) * 1e6 for c in factors]
+    assert errors[0] == pytest.approx(-errors[1], abs=1e-9)
+    assert abs(errors[0]) == pytest.approx(8.2993402, abs=1e-6)
+
+
+def test_known_utm_central_meridian_scale_and_fixed_origin():
+    result = ground_preview(samples=[sample("A", -93, 38), sample("B", -93, 39)],
+                            target_crs="EPSG:26915", origin_point_id="A")
+    assert result["grid_to_ground"] == pytest.approx(1 / 0.9996, abs=1e-10)
+    for row in result["rows"]:
+        assert row["TargetCombinedFactor"] == pytest.approx(0.9996, abs=1e-10)
+    a, b = result["rows"]
+    assert a["TargetEasting"] == pytest.approx(500000, abs=1e-6)
+    assert a["GroundEasting"] == a["TargetEasting"]
+    assert a["GroundNorthing"] == a["TargetNorthing"]
+    assert b["GroundNorthing"] - a["GroundNorthing"] == pytest.approx((b["TargetNorthing"] - a["TargetNorthing"]) / 0.9996, abs=0.0001)
+
+
+def test_multiple_missouri_grids_reproject_to_one_common_target():
+    samples = [sample("A", -91, 38, "EPSG:26996", 150), sample("B", -91, 38, "EPSG:26997", 150)]
+    result = ground_preview(samples=samples, target_crs="EPSG:26996", origin_point_id="A")
+    a, b = result["rows"]
+    assert a["SourceEasting"] != pytest.approx(b["SourceEasting"])
+    assert a["TargetEasting"] == pytest.approx(b["TargetEasting"], abs=1e-6)
+    assert a["TargetCombinedFactor"] == pytest.approx(b["TargetCombinedFactor"], abs=1e-12)
+    assert a["ElevationFactor"] < 1
+
+
+def test_bad_units_missing_origin_and_incompatible_datums_are_rejected():
+    samples = [sample("A", -93, 38), sample("B", -92, 39)]
+    with pytest.raises(ValueError, match="projected"):
+        ground_preview(samples=samples, target_crs="EPSG:4269", origin_point_id="A")
+    with pytest.raises(ValueError, match="origin"):
+        ground_preview(samples=samples, target_crs="EPSG:26915", origin_point_id="missing")
+    samples[1]["source_crs"] = "EPSG:26715"  # NAD27 / UTM15
+    with pytest.raises(ValueError, match="same geodetic"):
+        ground_preview(samples=samples, target_crs="EPSG:26915", origin_point_id="A")
+
+
+def test_nonconformal_projection_cannot_be_represented_by_one_scale():
+    samples = [sample("A", -93, 38), sample("B", -92, 39)]
+    with pytest.raises(ValueError, match="conformal"):
+        ground_preview(samples=samples, target_crs="EPSG:5070", origin_point_id="A")
+
+
+def test_parameter_change_updates_residuals_and_coordinate_rotation():
+    samples = [sample("A", -93, 38), sample("B", -93, 39)]
+    result = ground_preview(samples=samples, target_crs="EPSG:26915", origin_point_id="A",
+        grid_to_ground=1, rotation_deg=90, tolerance_ppm=20)
+    assert result["max_abs_residual_ppm"] == pytest.approx(400, abs=0.001)
+    assert not result["all_samples_within_tolerance"]
+    assert result["rows"][1]["GroundEasting"] < result["rows"][0]["GroundEasting"]
diff --git a/tests/test_sewer_pickup.py b/tests/test_sewer_pickup.py
new file mode 100644
index 0000000..11f0276
--- /dev/null
+++ b/tests/test_sewer_pickup.py
@@ -0,0 +1,105 @@
+import csv
+import io
+import zipfile
+from xml.etree import ElementTree as ET
+
+import pytest
+from pyproj import Geod
+
+from fieldbook_sync.models import AppState, MapLayer, MapFeature, SurveyPoint, ResultRecord, PipeMeasurement, ReviewState
+from fieldbook_sync.sewer_pickup import pickup_rows, build_pickup_kmz
+
+OPTIONS = dict(elevation_unit="ft", dip_unit="ft", confirmed_rim=True)
+BASE = (-90.2, 38.6)
+
+
+def shifted(metres):
+    return Geod(ellps="WGS84").fwd(*BASE, 90, metres)[:2]
+
+
+def scenario(gis_distances, survey_distances=(0,), *, accepted=True):
+    points = [SurveyPoint(point_id=str(i+1), code="MH") for i in range(len(survey_distances))]
+    results = [ResultRecord(point_id=p.point_id, code="MH", elevation=100, dip_status="YES",
+        review_state="ACCEPTED" if accepted else "UNREVIEWED", pipes=[PipeMeasurement(dip=6)]) for p in points]
+    features = [MapFeature(feature_id=f"GIS-{i}", geometry={"type":"Point", "coordinates":shifted(d)}, properties={"asset":str(i+1)}) for i,d in enumerate(gis_distances)]
+    state = AppState(survey_points=points, results=results, map_layers=[MapLayer(layer_id="sewers", name="Sewers", features=features)])
+    coords = {p.point_id: shifted(d) for p,d in zip(points, survey_distances)}
+    return state, coords
+
+
+def rows(state, coords, **overrides):
+    args = dict(layer_ids=["sewers"], id_field="", tolerance_m=2, calculation_options=OPTIONS)
+    args.update(overrides)
+    return pickup_rows(state, coords, **args)[0]
+
+
+def test_unique_match_clears_only_one_gis_pickup():
+    state, coords = scenario([0.5, 100])
+    result = rows(state, coords)
+    assert [r["Status"] for r in result] == ["COMPLETE", "MISSING_SURVEY"]
+    assert result[0]["MatchDistanceM"] == pytest.approx(0.5, abs=0.001)
+    assert result[0]["GISFeatureID"] == "GIS-0"
+
+
+@pytest.mark.parametrize("survey,gis", [([0, 0.8], [0.4]), ([0], [0, 0.5])])
+def test_ambiguous_matches_do_not_create_false_completion(survey, gis):
+    state, coords = scenario(gis, survey)
+    assert all(r["Status"] == "REVIEW" for r in rows(state, coords))
+
+
+def test_same_identity_outside_tolerance_is_review_not_missing():
+    state, coords = scenario([100])
+    assert [r["Status"] for r in rows(state, coords, id_field="asset")] == ["REVIEW", "REVIEW"]
+
+
+def test_duplicate_asset_ids_are_not_automatically_resolved():
+    state, coords = scenario([0, 100], [0, 100])
+    for f in state.map_layers[0].features:
+        f.properties["asset"] = "1"
+    assert all(r["Status"] == "REVIEW" for r in rows(state, coords, id_field="asset"))
+
+
+def test_status_requires_all_recorded_dips_and_review():
+    state, coords = scenario([0], accepted=False)
+    assert rows(state, coords)[0]["Status"] == "REVIEW"
+    state.results[0].review_state = ReviewState.ACCEPTED
+    state.results[0].pipes.append(PipeMeasurement(dip=None))
+    assert rows(state, coords)[0]["Status"] == "REVIEW"
+    state.results = []
+    assert rows(state, coords)[0]["Status"] == "MISSING_DIP"
+
+
+def test_unlocated_point_is_retained_in_checklist():
+    state, coords = scenario([])
+    coords["1"] = (None, None)
+    result = rows(state, coords, layer_ids=[])
+    assert result[0]["Status"] == "REVIEW" and result[0]["Longitude"] == ""
+
+
+def test_matching_handles_antimeridian():
+    state, coords = scenario([0])
+    coords["1"] = (179.999999, 0)
+    state.map_layers[0].features[0].geometry["coordinates"] = [-179.999999, 0]
+    assert rows(state, coords)[0]["Status"] == "COMPLETE"
+
+
+def test_kmz_is_self_contained_georeferenced_and_xml_safe():
+    state, coords = scenario([0, 100])
+    state.project_name = 'Project <test> & "check"'
+    result = rows(state, coords)
+    data = build_pickup_kmz(result, project_name=state.project_name, manifest={"fixture":True})
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        assert archive.testzip() is None
+        assert len([f for f in archive.namelist() if f.startswith("icons/")]) == 4
+        root = ET.fromstring(archive.read("doc.kml"))
+        ns = {"k":"http://www.opengis.net/kml/2.2"}
+        assert len(root.findall(".//k:Placemark", ns)) == 2
+        assert any(c.text.startswith("-90.2000000000,38.6000000000") for c in root.findall(".//k:coordinates", ns))
+        table = list(csv.DictReader(io.StringIO(archive.read("checklist.csv").decode("utf-8-sig"))))
+        assert len(table) == 2
+
+
+def test_missing_selected_layer_is_an_error():
+    state, coords = scenario([0])
+    with pytest.raises(ValueError, match="no longer"):
+        rows(state, coords, layer_ids=["deleted"])
diff --git a/tests/test_spatial_fields.py b/tests/test_spatial_fields.py
new file mode 100644
index 0000000..7f042e9
--- /dev/null
+++ b/tests/test_spatial_fields.py
@@ -0,0 +1,40 @@
+import json
+from datetime import date, datetime, time, timezone
+from decimal import Decimal
+from uuid import UUID
+
+import pytest
+
+from fieldbook_sync.map_gis import _sanitize_properties
+from fieldbook_sync.spatial_fields import TAG, preserve_value, scalar_identity
+
+
+def test_spatial_attributes_keep_nulls_nested_data_and_exact_long_ids():
+    props = _sanitize_properties({"null":None, "empty":"", "active":False, "id":9223372036854775807,
+        "list":[1,None,{"nested":False}], "precision":Decimal("1.000000000000000001"),
+        "date":date(2026,9,12), "time":time(12,30), "when":datetime(2026,9,12,12,tzinfo=timezone.utc),
+        "attachment":b"\x00\xff", "guid":UUID("00000000-0000-0000-0000-000000000001")})
+    restored = json.loads(json.dumps(props, allow_nan=False))
+    assert restored["null"] is None and restored["empty"] == "" and restored["active"] is False
+    assert restored["list"] == [1,None,{"nested":False}]
+    assert restored["id"] == {TAG:"integer", "value":"9223372036854775807"}
+    assert scalar_identity(restored["id"]) == "9223372036854775807"
+    assert restored["precision"]["value"] == "1.000000000000000001"
+    assert restored["attachment"]["value"] == "AP8="
+    assert restored["when"]["value"].endswith("+00:00")
+
+
+def test_literal_codec_shape_cannot_be_misread_as_a_numeric_id():
+    original = {TAG:"integer", "value":"123"}
+    result = preserve_value(original)
+    assert result == {TAG:"literal-object", "value":original}
+    assert scalar_identity(result) == ""
+
+
+def test_unknown_types_fail_instead_of_silent_string_conversion():
+    with pytest.raises(ValueError, match="Unsupported"):
+        preserve_value(object())
+
+
+def test_nonfinite_properties_remain_json_safe_and_explicit():
+    assert preserve_value(float("nan")) == {TAG:"float", "value":"nan"}
