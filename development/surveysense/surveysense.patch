+"""Explicit-unit pipe calculations and source-linked field-book review exports.
+
+These functions never modify observations or treat a calculated invert as a
+measured dip.  The professional survey-report template is a separate workflow.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import math
+from datetime import datetime, timezone
+from pathlib import Path
+from threading import Lock
+from xml.sax.saxutils import escape
+
+UNIT_METERS = {"m": 1.0, "ft": 0.3048, "usft": 1200.0 / 3937.0}
+UNIT_LABELS = {"m": "meters", "ft": "international feet", "usft": "US survey feet"}
+_font_lock = Lock()
+
+
+def _finite(value) -> bool:
+    return value is not None and not isinstance(value, bool) and math.isfinite(float(value))
+
+
+def pipe_calculation_rows(results, *, elevation_unit: str, dip_unit: str,
+                          confirmed_rim: bool) -> list[dict]:
+    if elevation_unit not in UNIT_METERS or dip_unit not in UNIT_METERS:
+        raise ValueError("Select explicit elevation and dip units: m, ft, or usft.")
+    rows = []
+    for result in results:
+        sources = sorted({f"{e.source_name}, page {e.page_number}" for e in result.evidence_records})
+        for index, pipe in enumerate(result.pipes or [None], 1):
+            issues = []
+            rim = result.elevation
+            dip = pipe.dip if pipe else None
+            invert = None
+            converted_dip = None
+            if not confirmed_rim:
+                issues.append("Surveyed elevation has not been confirmed as the rim reference")
+            if not _finite(rim):
+                issues.append("Missing or non-finite rim elevation")
+            if not _finite(dip):
+                issues.append("Missing or non-finite measured dip")
+            elif dip < 0:
+                issues.append("Negative dip requires review")
+            else:
+                converted_dip = float(dip) * UNIT_METERS[dip_unit] / UNIT_METERS[elevation_unit]
+                if confirmed_rim and _finite(rim):
+                    candidate = float(rim) - converted_dip
+                    if math.isfinite(candidate):
+                        invert = candidate
+                    else:
+                        issues.append("Calculation overflow requires review")
+            if result.qa_needs_review or result.dip_status.value == "REVIEW":
+                issues.append("Dip interpretation needs review")
+            if result.review_state.value not in {"ACCEPTED", "EDITED"}:
+                issues.append("Field-book interpretation has not been accepted by an operator")
+            issues.extend(result.qc_flags)
+            if pipe:
+                issues.extend(pipe.qc_flags)
+            rows.append({
+                "PointID": result.point_id,
+                "PipeIndex": index if pipe else "",
+                "RimElevation": float(rim) if _finite(rim) else "",
+                "ElevationUnit": elevation_unit,
+                "MeasuredDip": float(dip) if _finite(dip) else "",
+                "DipUnit": dip_unit,
+                "DipInElevationUnits": converted_dip if converted_dip is not None and math.isfinite(converted_dip) else "",
+                "CalculatedInvert": invert if invert is not None else "",
+                "DiameterIn": pipe.diameter_in if pipe and _finite(pipe.diameter_in) else "",
+                "Material": pipe.material or "" if pipe else "",
+                "AzimuthDeg": pipe.azimuth_deg if pipe and _finite(pipe.azimuth_deg) else "",
+                "DipRaw": pipe.dip_raw or "" if pipe else "",
+                "SourcePages": "; ".join(sources),
+                "ReviewState": result.review_state.value,
+                "QCNotes": "; ".join(dict.fromkeys(issues)),
+            })
+    return rows
+
+
+def _csv_value(value):
+    # Text fields can originate in filenames/notes. Prevent spreadsheet formulas
+    # without changing numeric measurement cells (including negative elevations).
+    if isinstance(value, str) and value.lstrip().startswith(("=", "+", "-", "@")):
+        return "'" + value
+    return value
+
+
+def pipe_calculations_csv(rows: list[dict]) -> bytes:
+    if not rows:
+        raise ValueError("There are no structure results to export.")
+    out = io.StringIO(newline="")
+    writer = csv.DictWriter(out, fieldnames=list(rows[0]), lineterminator="\r\n")
+    writer.writeheader()
+    writer.writerows({key: _csv_value(value) for key, value in row.items()} for row in rows)
+    return out.getvalue().encode("utf-8-sig")
+
+
+def _pdf_font() -> str:
+    from reportlab.pdfbase import pdfmetrics
+    from reportlab.pdfbase.ttfonts import TTFont
+    with _font_lock:
+        name = "SurveySenseSans"
+        if name in pdfmetrics.getRegisteredFontNames():
+            return name
+        import os
+        candidates = [
+            Path(os.environ.get("WINDIR", "C:/Windows")) / "Fonts/arial.ttf",
+            Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
+        ]
+        try:
+            import matplotlib
+            candidates.append(Path(matplotlib.get_data_path()) / "fonts/ttf/DejaVuSans.ttf")
+        except ImportError:
+            pass
+        for path in candidates:
+            if path.is_file():
+                pdfmetrics.registerFont(TTFont(name, str(path)))
+                return name
+    raise ValueError("A Unicode TrueType font is required for the review PDF (Arial or DejaVu Sans).")
+
+
+def build_fieldbook_review_pdf(state, rows: list[dict], destination: Path,
+                              *, page_root: Path, calculation_options: dict) -> Path:
+    """Build a review copy with source images and separate, readable note pages.
+
+    Page images are resolved only below the project's page directory.  An export
+    fails if referenced evidence is unavailable, instead of silently dropping it.
+    """
+    if not rows:
+        raise ValueError("There are no structure results to export.")
+    from reportlab.lib import colors
+    from reportlab.lib.styles import ParagraphStyle
+    from reportlab.lib.utils import ImageReader
+    from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, Image, PageBreak
+    font = _pdf_font()
+    root = page_root.resolve()
+    pages_by_id = {}
+    for source in state.fieldbook_pages:
+        if source.page_id in pages_by_id:
+            raise ValueError("Duplicate field-book page identifier; repair the project before exporting.")
+        pages_by_id[source.page_id] = source
+    refs = {e.page_id for r in state.results for e in r.evidence_records}
+    missing = refs - pages_by_id.keys()
+    if missing:
+        raise ValueError("Referenced field-book pages are missing: " + ", ".join(sorted(missing)))
+    image_paths = {}
+    for source in state.fieldbook_pages:
+        path = Path(source.image_path).resolve()
+        if not path.is_relative_to(root) or not path.is_file():
+            raise ValueError(f"Source image is unavailable in this project: {source.source_name}, page {source.page_number}")
+        image_paths[source.page_id] = path
+    body = ParagraphStyle("Body", fontName=font, fontSize=9, leading=13, spaceAfter=7)
+    small = ParagraphStyle("Small", parent=body, fontSize=7.5, leading=10, spaceAfter=3)
+    title = ParagraphStyle("Title", parent=body, fontSize=20, leading=26, spaceAfter=15,
+                           textColor=colors.HexColor("#12384a"))
+    heading = ParagraphStyle("Heading", parent=body, fontSize=12, leading=16, spaceBefore=8, spaceAfter=8)
+
+    def para(text, style=body):
+        return Paragraph(escape(str(text)).replace("\n", "<br/>"), style)
+
+    def show(value):
+        return "Not available" if value == "" or value is None else (f"{value:.4f}" if isinstance(value, float) else str(value))
+
+    def note_table(selected):
+        cells = [[para(x, small) for x in ["Structure / pipe", "Rim", "Dip", "Invert", "Review / evidence"]]]
+        for row in selected:
+            cells.append([
+                para(f"{row['PointID']} / {row['PipeIndex'] or 'No pipe'}", small),
+                para(f"{show(row['RimElevation'])}\n{row['ElevationUnit']}", small),
+                para(f"{show(row['MeasuredDip'])}\n{row['DipUnit']}", small),
+                para(f"{show(row['CalculatedInvert'])}\n{row['ElevationUnit']}", small),
+                para("\n".join(filter(None, [row['SourcePages'], row['QCNotes'] or 'Accepted measurement; no calculation flags'])), small),
+            ])
+        table = Table(cells, colWidths=[82, 70, 70, 70, 248], repeatRows=1, hAlign="LEFT", splitByRow=1, splitInRow=1)
+        table.setStyle(TableStyle([
+            ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#e6eef2")),
+            ("VALIGN", (0, 0), (-1, -1), "TOP"),
+            ("GRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#bdcbd2")),
+            ("LEFTPADDING", (0, 0), (-1, -1), 6),
+            ("RIGHTPADDING", (0, 0), (-1, -1), 6),
+            ("TOPPADDING", (0, 0), (-1, -1), 6),
+            ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
+        ]))
+        return table
+
+    stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
+    story = [para("Field-book dip review", title), para(state.project_name, heading),
+             para("SurveySense | Draft for review | " + stamp),
+             para("Calculated invert = confirmed rim elevation - measured vertical dip, converted to the elevation unit. Missing dips are not inferred."),
+             para("Elevation unit: " + UNIT_LABELS[calculation_options['elevation_unit']] +
+                  "; dip unit: " + UNIT_LABELS[calculation_options['dip_unit']] +
+                  "; rim reference confirmed: " + ("Yes" if calculation_options['confirmed_rim'] else "No")),
+             para("Project coordinate system: " + (state.map_project_crs_name or state.map_project_crs or "Not configured")),
+             Spacer(1, 8), note_table(rows)]
+    by_point = {}
+    for row in rows:
+        by_point.setdefault(row["PointID"], []).append(row)
+    for source in state.fieldbook_pages:
+        story.extend([PageBreak(), para(f"{source.source_name} - source page {source.page_number}", heading)])
+        image_path = image_paths[source.page_id]
+        width, height = ImageReader(str(image_path)).getSize()
+        if width <= 0 or height <= 0:
+            raise ValueError("Source page image has invalid dimensions.")
+        factor = min(528 / width, 598 / height)
+        story.append(Image(str(image_path), width=width * factor, height=height * factor, hAlign="CENTER"))
+        ids = {r.point_id for r in state.results if any(e.page_id == source.page_id for e in r.evidence_records)}
+        if ids:
+            notes = [row for point in sorted(ids) for row in by_point.get(point, [])]
+            story.extend([PageBreak(), para(f"Dip notes for {source.source_name} - page {source.page_number}", heading),
+                          para("These notes are associated with this source page. Their position on the original image has not been inferred."), note_table(notes)])
+
+    def footer(canvas, doc):
+        canvas.saveState()
+        canvas.setFont(font, 8)
+        canvas.setFillColor(colors.HexColor("#526773"))
+        canvas.drawString(36, 20, "SurveySense | Field-book review copy")
+        canvas.drawRightString(576, 20, f"Page {doc.page}")
+        canvas.restoreState()
+
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    doc = SimpleDocTemplate(str(destination), pagesize=(612, 792), leftMargin=36, rightMargin=36,
+                            topMargin=36, bottomMargin=36, title="SurveySense field-book dip review",
+                            author="SurveySense", allowSplitting=True)
+    try:
+        doc.build(story, onFirstPage=footer, onLaterPages=footer)
+    except Exception:
+        destination.unlink(missing_ok=True)
+        raise
+    return destination
