+/* Sampled common-grid ground design; no active coordinates are overwritten. */
+function parseSurveySenseCsv(text) {
+  const rows = []; let row = [], cell = '', quoted = false;
+  text = text.replace(/^\uFEFF/, '');
+  for (let i=0; i<text.length; i++) {
+    const ch = text[i];
+    if (ch === '"') {
+      if (quoted && text[i+1] === '"') { cell += '"'; i++; }
+      else quoted = !quoted;
+    } else if (!quoted && (ch === ',' || ch === '\n' || ch === '\r')) {
+      row.push(cell); cell = '';
+      if (ch !== ',') { if (row.some(v=>v.trim())) rows.push(row); row=[]; if (ch === '\r' && text[i+1] === '\n') i++; }
+    } else cell += ch;
+  }
+  if (quoted) throw new Error('The CSV has an unclosed quoted field.');
+  row.push(cell); if (row.some(v=>v.trim())) rows.push(row);
+  return rows;
+}
+
+function openGroundDesign() {
+  openModal('Multi-zone project ground preview', `
+    <form id="groundForm" style="display:grid;gap:14px">
+      <p>Convert sample coordinates from their source zones into one target grid, then inspect the residual distortion from a single project ground multiplier. Include samples across the project limits, zone transitions and height range.</p>
+      <div class="two-col"><label>Target grid CRS<input id="groundTarget" class="control" placeholder="EPSG code or full WKT" required></label><label>Fixed origin PointID<input id="groundOrigin" class="control" required></label></div>
+      <div class="two-col"><label>Rotation counterclockwise from target grid (degrees)<input id="groundRotation" class="control" type="number" step="any" value="0" required></label><label>Project distortion tolerance (ppm)<input id="groundTolerance" class="control" type="number" step="any" min="0.001" required></label></div>
+      <label>Sample CSV<input id="groundFile" type="file" accept=".csv,.txt,text/csv"></label>
+      <label>Paste or edit sample rows<textarea id="groundSamples" class="control" rows="7" spellcheck="false" required placeholder="PointID,SourceCRS,Easting,Northing,EllipsoidHeightM&#10;Use the actual source CRS and ellipsoid height for every sample."></textarea></label>
+      <label><input id="groundHeightConfirmed" type="checkbox" required> The heights are ellipsoid heights in metres, on the shared horizontal datum.</label>
+      <p class="hint">This preview supports static matching datum realizations. Orthometric elevations need a verified geoid conversion. Epoch transformations and final control adjustment require their own validated workflow.</p>
+      <div class="row"><button id="groundCalculate" class="btn primary" type="submit">Calculate preview</button><button id="groundClose" class="btn secondary" type="button">Close</button></div>
+      <p id="groundProgress" role="status"></p>
+    </form>
+    <section id="groundOutput" hidden style="margin-top:18px;display:grid;gap:14px">
+      <div class="two-col"><label>Grid-to-ground multiplier<input id="groundMultiplier" class="control" type="number" step="0.000000001" min="0.000000001"></label><label>Plot along target grid<select id="groundAxis" class="control"><option value="TargetEasting">Easting</option><option value="TargetNorthing">Northing</option></select></label></div>
+      <label>Explore multiplier near the fitted value<input id="groundSlider" type="range" step="0.000000001" style="width:100%"></label>
+      <p id="groundMetrics" role="status"></p>
+      <div id="groundPlot"></div><div id="groundLegend" class="hint"></div>
+      <p id="groundWarnings" class="hint"></p>
+      <div style="overflow:auto;max-height:280px"><table><thead><tr><th>Point</th><th>Source grid</th><th>Target combined factor</th><th>Residual ppm</th></tr></thead><tbody id="groundRows"></tbody></table></div>
+      <p class="hint">The graph shows local scale at supplied samples. The exported design includes all points, original inputs, the target CRS, origin, rotation and residuals. Check independent control before adopting it.</p>
+      <button id="groundExport" class="btn primary" type="button">Export ground design package</button>
+    </section>`, 'SURVEYSENSE COORDINATE DESIGN');
+  const form = document.querySelector('#groundForm');
+  const output = document.querySelector('#groundOutput');
+  output.style.display = 'none';
+  let preview = null, input = null;
+  const status = document.querySelector('#groundProgress');
+  const exportButton = document.querySelector('#groundExport');
+  const multiplierInput = document.querySelector('#groundMultiplier');
+  const slider = document.querySelector('#groundSlider');
+  const axis = document.querySelector('#groundAxis');
+  const finiteNumber = (value, label) => { if (!String(value ?? '').trim() || !Number.isFinite(Number(value))) throw new Error(`${label}: enter a finite number.`); return Number(value); };
+  const invalidate = () => { preview=null; input=null; output.style.display='none'; exportButton.disabled=true; };
+  form.addEventListener('input', invalidate);
+  document.querySelector('#groundClose').onclick = closeModal;
+  document.querySelector('#groundFile').onchange = async (event) => {
+    const file = event.target.files[0]; if (!file) return;
+    if (file.size > 5*1024*1024) { status.textContent='Use a sample CSV smaller than 5 MB.'; return; }
+    document.querySelector('#groundSamples').value = await file.text(); invalidate();
+  };
+  function draw() {
+    if (!preview) return;
+    const multiplier = Number(multiplierInput.value);
+    if (!Number.isFinite(multiplier) || multiplier <= 0) { exportButton.disabled=true; return; }
+    exportButton.disabled=false;
+    const rows = preview.rows.map(r=>({...r, residual:(multiplier*r.TargetCombinedFactor-1)*1e6}));
+    const maximum = Math.max(...rows.map(r=>Math.abs(r.residual)));
+    const tolerance = input.tolerance_ppm;
+    document.querySelector('#groundMetrics').textContent = `Maximum sampled distortion: ${maximum.toFixed(3)} ppm (${(maximum/1000).toFixed(4)} ${preview.coordinate_unit} per 1,000). ${maximum <= tolerance ? 'All samples meet' : 'Samples exceed'} the ${tolerance} ppm tolerance. Ground-to-grid: ${(1/multiplier).toFixed(10)}.`;
+    const zones=[...new Set(rows.map(r=>r.SourceCRS))];
+    const colors=['#59b9ee','#f18eaa','#70d4b2','#d9b75e','#b29bea','#e88762'];
+    const xs=rows.map(r=>r[axis.value]), lo=Math.min(...xs), hi=Math.max(...xs);
+    const ymax=Math.max(tolerance*1.3, maximum*1.12, 1);
+    const px=v=>72+(v-lo)/(hi-lo || 1)*780;
+    const py=v=>170-v/ymax*130;
+    const lines=[-tolerance,0,tolerance].map(v=>`<line x1="72" x2="852" y1="${py(v)}" y2="${py(v)}" stroke="${v ? '#be8d42' : '#8095a1'}" stroke-dasharray="${v?'5 4':'0'}"/><text x="62" y="${py(v)+4}" text-anchor="end" fill="currentColor" font-size="12">${v.toFixed(1)}</text>`).join('');
+    const dots=rows.map(r=>`<circle cx="${px(r[axis.value])}" cy="${py(r.residual)}" r="5" fill="${colors[zones.indexOf(r.SourceCRS)%colors.length]}"><title>${esc(r.PointID)} | ${esc(r.SourceCRS)} | ${r.residual.toFixed(3)} ppm</title></circle>`).join('');
+    document.querySelector('#groundPlot').innerHTML=`<svg viewBox="0 0 900 355" style="width:100%;max-height:360px;background:var(--panel);border:1px solid var(--line);border-radius:10px" role="img" aria-label="Residual scale in parts per million across project sample points"><text x="18" y="22" fill="currentColor" font-size="13">Residual ppm</text>${lines}${dots}<text x="72" y="327" fill="currentColor" font-size="12">${lo.toFixed(2)}</text><text x="852" y="327" text-anchor="end" fill="currentColor" font-size="12">${hi.toFixed(2)}</text><text x="465" y="348" text-anchor="middle" fill="currentColor" font-size="12">Target grid ${esc(axis.value==='TargetEasting'?'easting':'northing')} (${esc(preview.coordinate_unit)})</text></svg>`;
+    document.querySelector('#groundLegend').innerHTML=zones.map((zone,i)=>`<span style="margin-right:16px;color:${colors[i%colors.length]}">● ${esc(zone)}</span>`).join('');
+    document.querySelector('#groundRows').innerHTML=rows.slice(0,50).map(r=>`<tr><td>${esc(r.PointID)}</td><td>${esc(r.SourceCRS)}</td><td>${r.TargetCombinedFactor.toFixed(10)}</td><td>${r.residual.toFixed(3)}</td></tr>`).join('');
+    document.querySelector('#groundWarnings').textContent = [...preview.warnings, ...(rows.length>50?['Table shows the first 50 samples; the graph and export include all samples.']:[])].join(' ');
+  }
+  multiplierInput.oninput=()=>{slider.value=multiplierInput.value;draw();};
+  slider.oninput=()=>{multiplierInput.value=slider.value;draw();};
+  axis.onchange=draw;
+  form.onsubmit=async(event)=>{
+    event.preventDefault(); invalidate();
+    const button=document.querySelector('#groundCalculate'); button.disabled=true;
+    try {
+      const [headers,...records]=parseSurveySenseCsv(document.querySelector('#groundSamples').value);
+      const required=['PointID','SourceCRS','Easting','Northing','EllipsoidHeightM'];
+      const names=(headers||[]).map(h=>h.trim());
+      if (required.some(name=>!names.includes(name)) || new Set(names).size!==names.length) throw new Error(`CSV needs unique headers: ${required.join(', ')}.`);
+      const samples=records.map((record,index)=>{
+        if (record.length!==names.length) throw new Error(`CSV row ${index+2} has the wrong number of columns.`);
+        const cell=key=>record[names.indexOf(key)].trim();
+        return {point_id:cell('PointID'),source_crs:cell('SourceCRS'),easting:finiteNumber(cell('Easting'),`Row ${index+2} easting`),northing:finiteNumber(cell('Northing'),`Row ${index+2} northing`),ellipsoid_height_m:finiteNumber(cell('EllipsoidHeightM'),`Row ${index+2} ellipsoid height`)};
+      });
+      const payload={samples,target_crs:document.querySelector('#groundTarget').value.trim(),origin_point_id:document.querySelector('#groundOrigin').value.trim(),rotation_deg:finiteNumber(document.querySelector('#groundRotation').value,'Rotation'),tolerance_ppm:finiteNumber(document.querySelector('#groundTolerance').value,'Tolerance'),confirmed_ellipsoid_heights:document.querySelector('#groundHeightConfirmed').checked};
+      status.textContent='Reprojecting samples and calculating target-grid factors…';
+      const response=await fetch('/api/ground/preview',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
+      const data=await response.json();
+      if(!response.ok) throw new Error(typeof data.detail==='string'?data.detail:'Check the sample values and required settings.');
+      preview=data; input=payload;
+      multiplierInput.value=data.grid_to_ground.toFixed(12);
+      slider.min=(data.grid_to_ground-0.00025).toFixed(12); slider.max=(data.grid_to_ground+0.00025).toFixed(12); slider.value=multiplierInput.value;
+      output.hidden=false; output.style.display='grid'; draw(); status.textContent=`${data.rows.length} samples converted into ${data.target_crs}. Adjust the multiplier to explore its effect.`;
+    } catch(error) {status.textContent=error.message;}
+    finally {button.disabled=false;}
+  };
+  exportButton.onclick=async()=>{
+    if(!preview||!input) return;
+    exportButton.disabled=true;
+    try {
+      await deliveryDownload('/api/ground/design.zip',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...input,grid_to_ground:finiteNumber(multiplierInput.value,'Multiplier')})});
+      status.textContent='Ground design package created and recorded in the delivery audit.';
+    } catch(error) {status.textContent=error.message;}
+    finally {exportButton.disabled=false;}
+  };
+}
