diff --git a/fieldbook_sync/ground_design.py b/fieldbook_sync/ground_design.py
new file mode 100644
index 0000000..03e89bf
--- /dev/null
+++ b/fieldbook_sync/ground_design.py
@@ -0,0 +1,121 @@
+"""Sampled design preview for one project ground system across source grids.
+
+Static, matching geodetic datums only. This computes local differential scale;
+the preview is not a datum/epoch transformation or a control-network adjustment.
+"""
+from __future__ import annotations
+
+import math
+from functools import lru_cache
+
+import pyproj
+from pyproj import CRS, Proj, Transformer
+
+
+@lru_cache(maxsize=64)
+def _crs(value):
+    crs = CRS.from_user_input(value)
+    if not (crs.is_projected or crs.is_geographic) or crs.is_compound or crs.is_bound:
+        raise ValueError("Use an explicit horizontal projected or geographic CRS.")
+    if "Dynamic" in crs.datum.type_name or "Ensemble" in crs.datum.type_name:
+        raise ValueError("This preview requires a static datum realization. Dynamic frames and datum ensembles need a verified epoch-aware workflow.")
+    return crs
+
+
+def fit_minimax_multiplier(combined_factors):
+    factors = list(combined_factors)
+    if not factors or not all(math.isfinite(v) and v > 0 for v in factors):
+        raise ValueError("Combined factors must be finite and positive.")
+    # Minimizes max(abs(multiplier * CF - 1)) over the supplied target-grid samples.
+    return 2.0 / (min(factors) + max(factors))
+
+
+def _local_factor(crs, lon, lat, height):
+    factors = Proj(crs).get_factors(lon, lat, errcheck=True)
+    k1, k2 = factors.meridional_scale, factors.parallel_scale
+    if (not all(math.isfinite(v) and v > 0 for v in (k1, k2))
+            or abs(k1 - k2) > 1e-7 or abs(factors.angular_distortion) > 1e-4):
+        raise ValueError("A single directional scale requires a conformal projection at every sample.")
+    ellipsoid = crs.ellipsoid
+    a, b = ellipsoid.semi_major_metre, ellipsoid.semi_minor_metre
+    e2 = 1 - (b / a) ** 2
+    denominator = 1 - e2 * math.sin(math.radians(lat)) ** 2
+    n = a / math.sqrt(denominator)
+    m = a * (1 - e2) / denominator ** 1.5
+    radius = math.sqrt(m * n)
+    elevation_factor = radius / (radius + height)
+    grid_scale = (k1 + k2) / 2
+    return grid_scale, elevation_factor, grid_scale * elevation_factor
+
+
+def ground_preview(*, samples, target_crs, origin_point_id, rotation_deg=0.0,
+                   grid_to_ground=None, tolerance_ppm=20.0):
+    if not 2 <= len(samples) <= 5000:
+        raise ValueError("Supply between 2 and 5000 project sample points, covering the limits and height range.")
+    target = _crs(target_crs)
+    if not target.is_projected or len(target.axis_info) != 2:
+        raise ValueError("Choose one projected target grid with two horizontal axes.")
+    axes = target.axis_info
+    if axes[0].direction != "east" or axes[1].direction != "north" or axes[0].unit_conversion_factor != axes[1].unit_conversion_factor:
+        raise ValueError("The target grid must use easting/northing with matching linear units.")
+    if not math.isfinite(rotation_deg) or not math.isfinite(tolerance_ppm) or tolerance_ppm <= 0:
+        raise ValueError("Rotation must be finite and the distortion tolerance must be positive.")
+    if grid_to_ground is not None and (not math.isfinite(grid_to_ground) or grid_to_ground <= 0):
+        raise ValueError("Grid-to-ground multiplier must be finite and positive.")
+    rows, transforms, seen, warnings = [], {}, set(), []
+    to_lonlat = Transformer.from_crs(target, target.geodetic_crs, always_xy=True, allow_ballpark=False, only_best=True)
+    for sample in samples:
+        point_id = str(sample["point_id"]).strip()
+        if not point_id or point_id in seen:
+            raise ValueError("Every sample needs a unique, non-empty PointID.")
+        seen.add(point_id)
+        x, y, h = (float(sample[key]) for key in ("easting", "northing", "ellipsoid_height_m"))
+        if not all(math.isfinite(value) for value in (x, y, h)) or not -15000 <= h <= 100000:
+            raise ValueError(f"{point_id}: enter finite coordinates and an ellipsoid height in metres.")
+        source_key = sample["source_crs"]
+        source = _crs(source_key)
+        if not source.geodetic_crs.equals(target.geodetic_crs, ignore_axis_order=True):
+            raise ValueError(f"{point_id}: source and target must share the same geodetic datum realization. Transform datums and epochs in a verified workflow first.")
+        if source_key not in transforms:
+            transforms[source_key] = Transformer.from_crs(source, target, always_xy=True, allow_ballpark=False, only_best=True)
+        gx, gy = transforms[source_key].transform(x, y, errcheck=True)
+        lon, lat = to_lonlat.transform(gx, gy, errcheck=True)
+        if not all(math.isfinite(v) for v in (gx, gy, lon, lat)):
+            raise ValueError(f"{point_id}: coordinate conversion is outside the valid domain.")
+        grid_scale, elevation_factor, cf = _local_factor(target, lon, lat, h)
+        area = target.area_of_use
+        outside = bool(area and not (area.west <= lon <= area.east and area.south <= lat <= area.north))
+        if outside:
+            warnings.append(f"{point_id}: outside the target CRS area of use; review the project ground design.")
+        rows.append({"PointID": point_id, "SourceCRS": source.to_string(), "SourceEasting": x, "SourceNorthing": y,
+                     "EllipsoidHeightM": h, "TargetEasting": gx, "TargetNorthing": gy,
+                     "TargetLongitude": lon, "TargetLatitude": lat, "TargetGridScale": grid_scale,
+                     "ElevationFactor": elevation_factor, "TargetCombinedFactor": cf,
+                     "OutsideTargetArea": outside})
+    origin = next((r for r in rows if r["PointID"] == origin_point_id), None)
+    if origin is None:
+        raise ValueError("Choose a supplied sample PointID as the fixed ground-system origin.")
+    suggested = fit_minimax_multiplier(r["TargetCombinedFactor"] for r in rows)
+    multiplier = suggested if grid_to_ground is None else grid_to_ground
+    angle = math.radians(rotation_deg)
+    c, s = math.cos(angle), math.sin(angle)
+    for row in rows:
+        dx, dy = row["TargetEasting"] - origin["TargetEasting"], row["TargetNorthing"] - origin["TargetNorthing"]
+        row["GroundEasting"] = origin["TargetEasting"] + multiplier * (c * dx - s * dy)
+        row["GroundNorthing"] = origin["TargetNorthing"] + multiplier * (s * dx + c * dy)
+        row["ResidualPPM"] = (multiplier * row["TargetCombinedFactor"] - 1) * 1e6
+        row["DistanceErrorPer1000Units"] = row["ResidualPPM"] / 1000
+        row["WithinSampleTolerance"] = abs(row["ResidualPPM"]) <= tolerance_ppm
+    return {"method": "Common target grid; Gaussian-radius elevation factor; minimax sampled local scale",
+            "target_crs": target.to_string(), "target_wkt": target.to_wkt(),
+            "datum": target.datum.name, "coordinate_unit": axes[0].unit_name,
+            "origin_point_id": origin_point_id, "origin_easting": origin["TargetEasting"], "origin_northing": origin["TargetNorthing"],
+            "rotation_deg_ccw": rotation_deg, "suggested_grid_to_ground": suggested,
+            "grid_to_ground": multiplier, "ground_to_grid": 1 / multiplier,
+            "tolerance_ppm": tolerance_ppm, "max_abs_residual_ppm": max(abs(r["ResidualPPM"]) for r in rows),
+            "all_samples_within_tolerance": all(r["WithinSampleTolerance"] for r in rows),
+            "warnings": warnings, "rows": rows, "pyproj_version": pyproj.__version__, "proj_version": pyproj.proj_version_str,
+            "limitations": ["Residuals are local differential scale at the supplied samples, not a guarantee between them.",
+                "Ellipsoid heights must use the horizontal datum's ellipsoid; orthometric elevations need a verified geoid conversion.",
+                "Origin and rotation define a project ground system, which must retain these parameters alongside its target grid.",
+                "Validate against independent control and project tolerances before using ground coordinates for survey deliverables."]}
