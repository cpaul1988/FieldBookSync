--- /dev/null
+++ b/fieldbook_sync/spatial_fields.py
@@ -0,0 +1,71 @@
+"""JSON-safe preservation of imported spatial attributes.
+
+Tagged values retain types JSON cannot express. They are not coerced to display
+strings or rounded through JavaScript numbers. Native driver coverage is separate.
+"""
+from __future__ import annotations
+
+import base64
+import math
+from datetime import date, datetime, time
+from decimal import Decimal
+from uuid import UUID
+
+TAG = "$surveysense_type"
+
+
+def preserve_value(value):
+    def tagged(kind, text):
+        return {TAG: kind, "value": text}
+    if value is None or isinstance(value, (str, bool)):
+        return value
+    if isinstance(value, int):
+        return value if abs(value) <= 9007199254740991 else tagged("integer", str(value))
+    if isinstance(value, float):
+        return value if math.isfinite(value) else tagged("float", str(value))
+    if isinstance(value, datetime):
+        return tagged("datetime", value.isoformat())
+    if isinstance(value, date):
+        return tagged("date", value.isoformat())
+    if isinstance(value, time):
+        return tagged("time", value.isoformat())
+    if isinstance(value, Decimal):
+        return tagged("decimal", str(value))
+    if isinstance(value, UUID):
+        return tagged("uuid", str(value))
+    if isinstance(value, (bytes, bytearray, memoryview)):
+        return tagged("binary-base64", base64.b64encode(bytes(value)).decode("ascii"))
+    if isinstance(value, dict):
+        if not all(isinstance(key, str) for key in value):
+            raise ValueError("Spatial attribute objects require string keys.")
+        result = {key: preserve_value(item) for key, item in value.items()}
+        # Escape literal objects that resemble codec values, preserving identity.
+        return tagged("literal-object", result) if TAG in result else result
+    if isinstance(value, (list, tuple)):
+        items = [preserve_value(item) for item in value]
+        return tagged("tuple", items) if isinstance(value, tuple) else items
+    raise ValueError(f"Unsupported spatial attribute type '{type(value).__name__}'; convert it explicitly before import.")
+
+
+def scalar_identity(value):
+    if isinstance(value, dict) and value.get(TAG) in {"integer", "uuid"}:
+        return str(value["value"])
+    return str(value).strip() if isinstance(value, (str, int)) and not isinstance(value, bool) else ""
+
+
+def observed_schema(features):
+    names = sorted({key for feature in features for key in feature.properties})
+    fields = []
+    for name in names:
+        values = [feature.properties[name] for feature in features if name in feature.properties]
+        kinds = set()
+        for value in values:
+            kind = type(value).__name__
+            if isinstance(value, dict) and TAG in value:
+                kind = value[TAG]
+            kinds.add("null" if value is None else kind)
+        fields.append({"name": name, "observed_types": sorted(kinds),
+                       "null_count": sum(value is None for value in values),
+                       "missing_count": len(features) - len(values)})
+    return {"kind": "observed-imported-values", "fields": fields,
+            "note": "Observed values do not establish the original nullable constraints, domains or subtypes."}
