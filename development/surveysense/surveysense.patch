+/* SurveySense delivery tools. Measurement units are always an explicit choice. */
+async function deliveryDownload(url, options = {}) {
+  const response = await fetch(url, options);
+  if (!response.ok) {
+    let message = `Export failed (HTTP ${response.status}).`;
+    try { const body = await response.json(); message = typeof body.detail === 'string' ? body.detail : message; } catch (_) {}
+    throw new Error(message);
+  }
+  const blob = await response.blob();
+  const match = /filename="?([^";]+)"?/i.exec(response.headers.get('Content-Disposition') || '');
+  const anchor = document.createElement('a');
+  const objectUrl = URL.createObjectURL(blob);
+  anchor.href = objectUrl;
+  anchor.download = match?.[1] || 'SurveySense_export.json';
+  document.body.appendChild(anchor);
+  anchor.click();
+  setTimeout(() => { URL.revokeObjectURL(objectUrl); anchor.remove(); }, 1000);
+}
+
+async function exportProjectPointRanges() {
+  try {
+    await deliveryDownload('/api/survey/available-ranges');
+    toast('Point ranges exported from the complete raw PointID inventory.', 'good');
+  } catch (error) { toast(error.message, 'error'); }
+}
+
+function openPipeDelivery(kind) {
+  const isPdf = kind === 'fieldbook-review.pdf';
+  const options = '<option value="">Choose units…</option><option value="m">Meters</option><option value="ft">International feet</option><option value="usft">US survey feet</option>';
+  openModal(isPdf ? 'Field-book review PDF' : 'Pipe calculation CSV', `
+    <form id="pipeDeliveryForm" style="max-width:680px;display:grid;gap:16px">
+      <p>Export the measured dips and calculate each pipe’s invert from its confirmed rim elevation. Missing measurements remain marked for review.</p>
+      <label>Surveyed elevation units<select id="deliveryElevationUnit" class="control" required>${options}</select></label>
+      <label>Measured dip units<select id="deliveryDipUnit" class="control" required>${options}</select></label>
+      <label><input id="deliveryConfirmedRim" type="checkbox"> These surveyed elevations are the rim reference used for the dip measurements.</label>
+      <p class="hint">${isPdf ? 'The PDF includes source-page images and separate per-pipe note pages. The original field book remains available.' : 'The CSV records source pages, raw dip text, units, converted depths, calculated inverts and unresolved QC.'}</p>
+      <p id="deliveryProgress" role="status" class="hint"></p>
+      <div class="row"><button id="deliveryGenerate" class="btn primary" type="submit">${isPdf ? 'Create review PDF' : 'Export calculations'}</button><button id="deliveryCancel" class="btn secondary" type="button">Close</button></div>
+    </form>`, 'SURVEYSENSE EXPORT');
+  document.querySelector('#deliveryCancel').addEventListener('click', closeModal);
+  document.querySelector('#pipeDeliveryForm').addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const button = document.querySelector('#deliveryGenerate');
+    const progress = document.querySelector('#deliveryProgress');
+    const payload = {
+      elevation_unit: document.querySelector('#deliveryElevationUnit').value,
+      dip_unit: document.querySelector('#deliveryDipUnit').value,
+      confirmed_rim: document.querySelector('#deliveryConfirmedRim').checked
+    };
+    button.disabled = true;
+    progress.textContent = 'Creating and checking the export…';
+    try {
+      await deliveryDownload(`/api/delivery/${kind}`, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
+      progress.textContent = 'Export created. Its calculation settings and checksum were saved in the delivery audit.';
+      toast('SurveySense export created.', 'good');
+    } catch (error) {
+      progress.textContent = error.message;
+      toast(error.message, 'error');
+    } finally { button.disabled = false; }
+  });
+}
+
+async function exportDeliveryAudit() {
+  try { await deliveryDownload('/api/delivery-audit'); }
+  catch (error) { toast(error.message, 'error'); }
+}
+
+async function openSewerPickup() {
+  let settings;
+  try {
+    const response = await fetch('/api/sewer/pickup-options');
+    if (!response.ok) throw new Error('Could not read the project GIS layers.');
+    settings = await response.json();
+  } catch (error) { toast(error.message, 'error'); return; }
+  const units = '<option value="">Choose units…</option><option value="m">Meters</option><option value="ft">International feet</option><option value="usft">US survey feet</option>';
+  openModal('Sewer pickup KMZ', `
+    <form id="pickupForm" style="max-width:720px;display:grid;gap:14px">
+      <p>Show missing surveys, missing dips, completed recorded pipes, and items needing review. Import a supplemental sewer structure point layer from Map to include expected structures.</p>
+      <p class="hint">Project CRS: ${esc(settings.project_crs || 'Not set — set it in Map before export')}. Survey points use the current map alignment.</p>
+      <label>Supplemental structure layer<select id="pickupLayer" class="control"><option value="">Surveyed structures only</option>${settings.layers.filter(l=>l.point_count).map(l=>`<option value="${esc(l.layer_id)}">${esc(l.name)} (${l.point_count} points)</option>`).join('')}</select></label>
+      <label>GIS asset ID field<select id="pickupIdField" class="control"><option value="">Match by unique proximity</option></select></label>
+      <label>Maximum matching distance (metres)<input id="pickupTolerance" class="control" type="number" step="any" min="0.001" max="1000" required></label>
+      <label>Surveyed elevation units<select id="pickupElevation" class="control" required>${units}</select></label>
+      <label>Measured dip units<select id="pickupDip" class="control" required>${units}</select></label>
+      <label><input type="checkbox" id="pickupRim"> These surveyed elevations are the rim reference used for the dip measurements.</label>
+      <p class="hint">Only unique matches within tolerance clear a GIS pickup. Completion requires operator-reviewed measurements for every recorded pipe. Unlocated points remain in the included checklist.</p>
+      <p id="pickupProgress" role="status"></p>
+      <div class="row"><button id="pickupExport" class="btn primary" type="submit">Create pickup KMZ</button><button id="pickupClose" class="btn secondary" type="button">Close</button></div>
+    </form>`, 'SURVEYSENSE FIELD COMPLETION');
+  document.querySelector('#pickupClose').onclick = closeModal;
+  document.querySelector('#pickupLayer').onchange = (event) => {
+    const layer = settings.layers.find(l=>l.layer_id === event.target.value);
+    document.querySelector('#pickupIdField').innerHTML = '<option value="">Match by unique proximity</option>' + (layer?.fields || []).map(field=>`<option value="${esc(field)}">${esc(field)}</option>`).join('');
+  };
+  document.querySelector('#pickupForm').onsubmit = async (event) => {
+    event.preventDefault();
+    const button = document.querySelector('#pickupExport');
+    const progress = document.querySelector('#pickupProgress');
+    const layer = document.querySelector('#pickupLayer').value;
+    const payload = {layer_ids: layer ? [layer] : [], id_field: document.querySelector('#pickupIdField').value,
+      tolerance_m: Number(document.querySelector('#pickupTolerance').value),
+      elevation_unit: document.querySelector('#pickupElevation').value, dip_unit: document.querySelector('#pickupDip').value,
+      confirmed_rim: document.querySelector('#pickupRim').checked};
+    button.disabled = true;
+    progress.textContent = 'Matching structures and checking the KMZ…';
+    try {
+      await deliveryDownload('/api/sewer/pickup.kmz', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
+      progress.textContent = 'Pickup KMZ created. The archive includes checklist.csv and its calculation and matching settings.';
+    } catch(error) { progress.textContent = error.message; }
+    finally { button.disabled = false; }
+  };
+}
